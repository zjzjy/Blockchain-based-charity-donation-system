# 网络配置
CHANNEL_NAME=mercychannel                   # 区块链通道名称
CHAINCODE_NAME=mercy                      # 智能合约名称
CHAINCODE_VERSION=1.0                     # 智能合约版本

# 证书路径配置
ORDERER_CA=../organizations/ordererOrganizations/example.com/orderers/orderer.example.com/tls/ca.crt
CA_PATH=../organizations/peerOrganizations/donororg.example.com/ca/ca.donororg.example.com-cert.pem
USER_PATH=../organizations/peerOrganizations/donororg.example.com/users/Admin@donororg.example.com/msp

# 组织配置
ORG_NAME=DonorOrg                         # 组织名称
ORG_MSPID=DonorOrgMSP                     # 组织MSP ID
PEER_ADDRESS=peer0.donororg.example.com:7051  # 节点地址
ORDERER_ADDRESS=orderer.example.com:7050  # 排序节点地址

# 慈善机构组织配置
CHARITY_ORG_NAME=CharityOrg               # 慈善机构组织名称
CHARITY_ORG_MSPID=CharityOrgMSP           # 慈善机构组织MSP ID
CHARITY_PEER_ADDRESS=peer0.charityorg.example.com:9051  # 慈善机构节点地址
CHARITY_CA_PATH=../organizations/peerOrganizations/charityorg.example.com/ca/ca.charityorg.example.com-cert.pem
CHARITY_USER_PATH=../organizations/peerOrganizations/charityorg.example.com/users/Admin@charityorg.example.com/msp

# 数据库配置
DB_HOST=localhost                         # 数据库主机
DB_PORT=5432                             # 数据库端口
DB_NAME=mercy_db                          # 数据库名称
DB_USER=admin                            # 数据库用户名
DB_PASSWORD=adminpw                      # 数据库密码

# 日志配置
LOG_LEVEL=info                           # 日志级别：debug, info, warn, error
LOG_FILE=mercy.log                       # 日志文件路径
LOG_FORMAT=json                          # 日志格式：json, text
LOG_MAX_SIZE=100m                        # 单个日志文件最大大小
LOG_MAX_FILES=10                         # 最大日志文件数量

# 应用配置
MAX_DONATION_AMOUNT=1000000              # 最大捐赠金额
MIN_DONATION_AMOUNT=1                    # 最小捐赠金额
DEFAULT_CURRENCY=CNY                     # 默认货币类型
MAX_PROJECT_DURATION=365                 # 最大项目持续时间（天）
MIN_PROJECT_DURATION=30                  # 最小项目持续时间（天）

# 项目所有者配置
# PROJECT_OWNER_ID=projectOwner1           # 项目所有者ID
# PROJECT_OWNER_EMAIL=owner@example.com    # 项目所有者邮箱
# PROJECT_OWNER_PHONE=13800138000         # 项目所有者电话
# PROJECT_OWNER_ADDRESS=北京市朝阳区        # 项目所有者地址

# 捐赠者配置
# DONOR_KYC_REQUIRED=true                  # 是否需要KYC验证
# DONOR_MIN_AGE=18                         # 捐赠者最小年龄
# DONOR_MAX_AGE=100                        # 捐赠者最大年龄

# 安全配置
JWT_SECRET=your-secret-key               # JWT密钥
JWT_EXPIRY=24h                           # JWT过期时间
ENCRYPTION_KEY=your-encryption-key       # 加密密钥
API_RATE_LIMIT=100                       # API速率限制（次/分钟）

# 通知配置
SMTP_HOST=smtp.example.com              # SMTP服务器地址
SMTP_PORT=587                           # SMTP端口
SMTP_USER=notify@example.com            # SMTP用户名
SMTP_PASSWORD=your-smtp-password        # SMTP密码
NOTIFICATION_EMAIL=notify@example.com    # 通知邮箱

# 监控配置
PROMETHEUS_PORT=9090                    # Prometheus端口
GRAFANA_PORT=3000                       # Grafana端口
ALERT_EMAIL=alert@example.com           # 告警邮箱

# 缓存配置
REDIS_HOST=localhost                    # Redis主机
REDIS_PORT=6379                         # Redis端口
REDIS_PASSWORD=your-redis-password      # Redis密码
CACHE_TTL=3600                          # 缓存过期时间（秒）

# 文件存储配置
FILE_STORAGE_TYPE=local                 # 文件存储类型：local, s3, oss
FILE_UPLOAD_PATH=/uploads              # 文件上传路径
MAX_FILE_SIZE=10m                      # 最大文件大小
ALLOWED_FILE_TYPES=jpg,png,pdf         # 允许的文件类型

# 系统配置
NODE_ENV=development                   # 环境：development, production, test
DEBUG=true                             # 调试模式
API_VERSION=v1                         # API版本