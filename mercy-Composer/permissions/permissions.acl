/**
 * 慈善捐赠系统访问控制规则
 * 这个文件定义了不同参与者对系统资源的访问权限
 */

/**
 * 默认规则 - 拒绝所有访问
 * 这条规则确保没有明确授权的访问都将被拒绝
 */
rule Default {
    description: "默认拒绝所有访问"
    participant: "ANY"
    operation: ALL
    resource: "org.mercy.charity.*"
    action: DENY
}

//=========== 捐赠者权限 ===========

/**
 * 捐赠者可以查看自己的个人资料
 */
rule DonorCanViewOwnProfile {
    description: "允许捐赠者查看自己的个人资料"
    participant(p): "org.mercy.charity.Donor"
    operation: READ
    resource(r): "org.mercy.charity.Donor"
    condition: (r.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 捐赠者可以更新自己的个人资料（部分字段）
 */
rule DonorCanUpdateOwnProfile {
    description: "允许捐赠者更新自己的部分个人资料"
    participant(p): "org.mercy.charity.Donor"
    operation: UPDATE
    resource(r): "org.mercy.charity.Donor"
    condition: (r.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 捐赠者可以查看所有项目
 */
rule DonorCanViewProjects {
    description: "允许捐赠者查看所有项目"
    participant: "org.mercy.charity.Donor"
    operation: READ
    resource: "org.mercy.charity.Project"
    action: ALLOW
}

/**
 * 捐赠者可以查询自己的捐赠记录
 */
rule DonorCanViewOwnDonations {
    description: "允许捐赠者查看自己的捐赠记录"
    participant(p): "org.mercy.charity.Donor"
    operation: READ
    resource(r): "org.mercy.charity.Donation"
    condition: (r.donor.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 已验证的捐赠者可以进行捐赠
 */
rule VerifiedDonorCanDonate {
    description: "允许已验证的捐赠者进行捐赠"
    participant(p): "org.mercy.charity.Donor"
    operation: CREATE
    resource(r): "org.mercy.charity.MakeDonation"
    condition: (p.kycVerified === true)
    action: ALLOW
}

//=========== 项目所有者权限 ===========

/**
 * 项目所有者可以查看自己的项目
 */
rule ProjectOwnerCanViewOwnProjects {
    description: "允许项目所有者查看自己的项目"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: READ
    resource(r): "org.mercy.charity.Project"
    condition: (r.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以更新自己的项目
 */
rule ProjectOwnerCanUpdateOwnProjects {
    description: "允许项目所有者更新自己的项目"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: UPDATE
    resource(r): "org.mercy.charity.Project"
    condition: (r.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以查看自己项目的捐赠记录
 */
rule ProjectOwnerCanViewProjectDonations {
    description: "允许项目所有者查看自己项目的捐赠记录"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: READ
    resource(r): "org.mercy.charity.Donation"
    condition: (r.project.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以更新项目里程碑
 */
rule ProjectOwnerCanUpdateMilestone {
    description: "允许项目所有者更新项目里程碑"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: CREATE
    resource(r): "org.mercy.charity.UpdateMilestone"
    condition: (r.project.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

//=========== 管理员权限 ===========

/**
 * 管理员可以管理所有资源
 */
rule AdminCanManageAll {
    description: "允许管理员管理所有资源"
    participant: "org.mercy.charity.Admin"
    operation: ALL
    resource: "org.mercy.charity.*"
    action: ALLOW
}

//=========== 审计员权限 ===========

/**
 * 审计员可以查看所有资源
 */
rule AuditorCanViewAll {
    description: "允许审计员查看所有资源"
    participant: "org.mercy.charity.Auditor"
    operation: READ
    resource: "org.mercy.charity.*"
    action: ALLOW
}

/**
 * 审计员可以更新项目的合规状态
 */
rule AuditorCanUpdateCompliance {
    description: "允许审计员更新项目的合规状态"
    participant: "org.mercy.charity.Auditor"
    operation: UPDATE
    resource(r): "org.mercy.charity.Project"
    condition: (r.complianceStatus !== "BLACKLISTED" || r.complianceStatus === null)
    action: ALLOW
}

//=========== 系统交易权限 ===========

/**
 * 允许所有参与者访问系统交易
 */
rule SystemACL {
  description: "允许所有参与者访问系统命名空间"
  participant: "ANY"
  operation: ALL
  resource: "org.hyperledger.composer.system.**"
  action: ALLOW
}

rule NetworkAdminUser {
    description: "授予网络管理员用户完全访问权限"
    participant: "org.hyperledger.composer.system.NetworkAdmin"
    operation: ALL
    resource: "**"
    action: ALLOW
}

rule NetworkAdminSystem {
    description: "授予网络管理员系统完全访问权限"
    participant: "org.hyperledger.composer.system.NetworkAdmin"
    operation: ALL
    resource: "org.hyperledger.composer.system.**"
    action: ALLOW
} 