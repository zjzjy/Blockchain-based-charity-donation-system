/**
 * 慈善捐赠系统MVP版本的访问控制规则
 * 这个文件定义了不同参与者对系统资源的访问权限
 */

/**
 * 默认规则 - 拒绝所有访问
 */
rule Default {
    description: "默认拒绝所有访问"
    participant: "ANY"
    operation: ALL
    resource: "org.mercy.charity.*"
    action: DENY
}

//=========== 捐赠者权限 ===========

/**
 * 捐赠者可以查看自己的个人资料
 */
rule DonorCanViewOwnProfile {
    description: "允许捐赠者查看自己的个人资料"
    participant(p): "org.mercy.charity.Donor"
    operation: READ
    resource(r): "org.mercy.charity.Donor"
    condition: (r.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 捐赠者可以查看所有项目
 */
rule DonorCanViewProjects {
    description: "允许捐赠者查看所有项目"
    participant: "org.mercy.charity.Donor"
    operation: READ
    resource: "org.mercy.charity.Project"
    action: ALLOW
}

/**
 * 捐赠者可以查询自己的捐赠记录
 */
rule DonorCanViewOwnDonations {
    description: "允许捐赠者查看自己的捐赠记录"
    participant(p): "org.mercy.charity.Donor"
    operation: READ
    resource(r): "org.mercy.charity.Donation"
    condition: (r.donor.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 捐赠者可以进行捐赠
 */
rule DonorCanDonate {
    description: "允许捐赠者进行捐赠"
    participant: "org.mercy.charity.Donor"
    operation: CREATE
    resource: "org.mercy.charity.MakeDonation"
    action: ALLOW
}

/**
 * 捐赠者可以审核里程碑并决定是否释放资金
 */
rule DonorCanApproveFunding {
    description: "允许捐赠者审核里程碑并决定是否释放资金"
    participant: "org.mercy.charity.Donor"
    operation: CREATE
    resource: "org.mercy.charity.ApproveMilestoneFunding"
    action: ALLOW
}

//=========== 项目所有者权限 ===========

/**
 * 项目所有者可以查看自己的资料
 */
rule ProjectOwnerCanViewOwnProfile {
    description: "允许项目所有者查看自己的资料"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: READ
    resource(r): "org.mercy.charity.ProjectOwner"
    condition: (r.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以创建项目
 */
rule ProjectOwnerCanCreateProject {
    description: "允许项目所有者创建项目"
    participant: "org.mercy.charity.ProjectOwner"
    operation: CREATE
    resource: "org.mercy.charity.Project"
    action: ALLOW
}

/**
 * 项目所有者可以查看自己的项目
 */
rule ProjectOwnerCanViewOwnProjects {
    description: "允许项目所有者查看自己的项目"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: READ
    resource(r): "org.mercy.charity.Project"
    condition: (r.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以更新自己的项目
 */
rule ProjectOwnerCanUpdateOwnProjects {
    description: "允许项目所有者更新自己的项目"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: UPDATE
    resource(r): "org.mercy.charity.Project"
    condition: (r.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以查看自己项目的捐赠记录
 */
rule ProjectOwnerCanViewProjectDonations {
    description: "允许项目所有者查看自己项目的捐赠记录"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: READ
    resource(r): "org.mercy.charity.Donation"
    condition: (r.project.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以更新项目状态
 */
rule ProjectOwnerCanUpdateProjectStatus {
    description: "允许项目所有者更新项目状态"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: CREATE
    resource(r): "org.mercy.charity.UpdateProjectStatus"
    condition: (r.project.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

/**
 * 项目所有者可以更新项目里程碑
 */
rule ProjectOwnerCanUpdateMilestone {
    description: "允许项目所有者更新项目里程碑"
    participant(p): "org.mercy.charity.ProjectOwner"
    operation: CREATE
    resource(r): "org.mercy.charity.UpdateMilestone"
    condition: (r.project.owner.getIdentifier() === p.getIdentifier())
    action: ALLOW
}

//=========== 系统交易权限 ===========

/**
 * 允许所有参与者访问系统交易
 */
rule SystemACL {
  description: "允许所有参与者访问系统命名空间"
  participant: "ANY"
  operation: ALL
  resource: "org.hyperledger.composer.system.**"
  action: ALLOW
}

rule NetworkAdminUser {
    description: "授予网络管理员用户完全访问权限"
    participant: "org.hyperledger.composer.system.NetworkAdmin"
    operation: ALL
    resource: "**"
    action: ALLOW
}

rule NetworkAdminSystem {
    description: "授予网络管理员系统完全访问权限"
    participant: "org.hyperledger.composer.system.NetworkAdmin"
    operation: ALL
    resource: "org.hyperledger.composer.system.**"
    action: ALLOW
} 